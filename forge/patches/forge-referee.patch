+
+    // [referee patch] Aristocrats play: when an opponent's spell or ability on top of the stack is about to remove
+    // one of our creatures, sacrifice that creature to a free outlet in response so death triggers still happen.
+    // Non-mana outlets (Viscera Seer, Carrion Feeder...) are returned to be played normally; a free mana outlet
+    // (Ashnod's Altar) is activated directly, since mana abilities don't use the stack. Returns null to fall through.
+    public static SpellAbility sacrificeThreatenedInResponse(final Player ai) {
+        final Game game = ai.getGame();
+        if (game.getStack().isEmpty()) return null;
+        final SpellAbility top = game.getStack().peekAbility();
+        if (top == null || top.getActivatingPlayer() == null || !top.getActivatingPlayer().isOpponentOf(ai)) return null;
+        Card victim = null;
+        for (GameObject o : ComputerUtil.predictThreatenedObjects(ai, null, true)) {
+            if (o instanceof Card) {
+                Card c = (Card) o;
+                if (c.isCreature() && c.getController().equals(ai) && c.isInPlay() && !c.isCommander()) {
+                    if (victim == null || ComputerUtilCard.evaluateCreature(c) > ComputerUtilCard.evaluateCreature(victim)) victim = c;
+                }
+            }
+        }
+        if (victim == null) return null;
+        SpellAbility manaOutlet = null;
+        for (Card outlet : ai.getCardsIn(ZoneType.Battlefield)) {
+            for (SpellAbility sa : outlet.getSpellAbilities()) {
+                if (!sa.isActivatedAbility() && !sa.isManaAbility()) continue;
+                final Cost cost = sa.getPayCosts();
+                if (cost == null || cost.hasManaCost() || cost.hasTapCost() || cost.getCostParts().size() != 1) continue;
+                final CostPart part = cost.getCostParts().get(0);
+                if (!(part instanceof CostSacrifice) || part.payCostFromSource() || !part.getType().startsWith("Creature")) continue;
+                if (outlet.equals(victim) && !part.getType().contains("Other")) { /* sacrificing itself is fine */ }
+                if (part.getType().contains("Other") && outlet.equals(victim)) continue;
+                sa.setActivatingPlayer(ai);
+                if (!sa.canPlay()) continue;
+                if (sa.isManaAbility()) { if (manaOutlet == null) manaOutlet = sa; continue; }
+                victim.setSVar("SacMe", "6");   // make the cost payment pick the threatened creature
+                return sa;
+            }
+        }
+        if (manaOutlet != null) {
+            victim.setSVar("SacMe", "6");
+            final CostPayment pay = new CostPayment(manaOutlet.getPayCosts(), manaOutlet);
+            if (pay.payComputerCosts(new AiCostDecision(ai, manaOutlet, false))) {
+                AbilityUtils.resolve(manaOutlet);
+            }
+            if (victim.isInPlay()) victim.removeSVar("SacMe");
+        }
+        return null;
+    }
+}
