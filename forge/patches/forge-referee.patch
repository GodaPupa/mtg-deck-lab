diff --git a/forge-game/src/main/java/forge/game/RefereeCombos.java b/forge-game/src/main/java/forge/game/RefereeCombos.java
new file mode 100644
index 00000000..7b790930
--- /dev/null
+++ b/forge-game/src/main/java/forge/game/RefereeCombos.java
@@ -0,0 +1,118 @@
+package forge.game;
+
+import forge.game.card.Card;
+import forge.game.player.Player;
+import forge.game.zone.ZoneType;
+
+import java.io.BufferedReader;
+import java.io.FileReader;
+import java.util.*;
+
+/**
+ * [deck-lab patch] Combo adjudication inside the engine.
+ *
+ * Forge's AI can't execute loops, so instead of playing them out, the engine declares the win the moment a
+ * known combo is legitimately live for the player whose turn it is: the player's key cards (usually the commander)
+ * and every piece are on the battlefield under their control, and they control at least 4 lands.
+ * Opponents have already had their chance to counter or remove each piece as it was cast.
+ *
+ * Enabled by -Dreferee.combos=/path/combos.txt. Each line: deckName|key1;key2|noSameTurn1;...|piece1;piece2;...
+ * (deckName is the Name= of the .dck, matched against "Ai(n)-deckName"). noSameTurn cards (e.g. Glint-Horn,
+ * which only works while attacking) must have been on the battlefield since before this turn.
+ * -Dreferee.mode=strict additionally requires every piece to have been on the battlefield since before this turn.
+ * Also exposes the combo list to the AI for combo-aware tutoring and mulligans.
+ */
+public final class RefereeCombos {
+    public static final class Deck {
+        public final Set<String> key = new HashSet<>();
+        public final Set<String> noSameTurn = new HashSet<>();
+        public final List<Set<String>> combos = new ArrayList<>();
+        public final Set<String> pieces = new HashSet<>();
+        public final Set<String> protection = new HashSet<>();
+    }
+
+    private static Map<String, Deck> decks = null;
+    private static final boolean STRICT = "strict".equalsIgnoreCase(System.getProperty("referee.mode", "realistic"));
+
+    private RefereeCombos() { }
+
+    public static synchronized Map<String, Deck> decks() {
+        if (decks != null) return decks;
+        decks = new HashMap<>();
+        final String path = System.getProperty("referee.combos");
+        if (path == null) return decks;
+        try (BufferedReader r = new BufferedReader(new FileReader(path))) {
+            String line;
+            while ((line = r.readLine()) != null) {
+                if (line.isBlank() || line.startsWith("#")) continue;
+                String[] f = line.split("\\|", -1);
+                if (f[0].equals("PROTECT") && f.length >= 3) {   // PROTECT|deckName|card1;card2
+                    Deck pd = decks.computeIfAbsent(f[1].trim(), k -> new Deck());
+                    for (String x : f[2].split(";")) if (!x.isBlank()) pd.protection.add(x.trim());
+                    continue;
+                }
+                if (f.length < 4) continue;
+                Deck d = decks.computeIfAbsent(f[0].trim(), k -> new Deck());
+                for (String s : f[1].split(";")) if (!s.isBlank()) d.key.add(s.trim());
+                for (String s : f[2].split(";")) if (!s.isBlank()) d.noSameTurn.add(s.trim());
+                Set<String> combo = new HashSet<>();
+                for (String s : f[3].split(";")) if (!s.isBlank()) combo.add(s.trim());
+                if (!combo.isEmpty()) { d.combos.add(combo); d.pieces.addAll(combo); }
+            }
+        } catch (Exception e) {
+            System.err.println("[referee] could not read combos: " + e);
+        }
+        return decks;
+    }
+
+    /** The deck name behind an AI player's name ("Ai(2)-GA Ashnod" -> "GA Ashnod"). */
+    public static String deckName(Player p) {
+        String n = p.getName();
+        int i = n.indexOf(")-");
+        return i >= 0 ? n.substring(i + 2) : n;
+    }
+
+    public static Deck deckOf(Player p) {
+        return decks().get(deckName(p));
+    }
+
+    private static boolean settled(Card c, Game game) {
+        return c.getTurnInZone() < game.getPhaseHandler().getTurn();
+    }
+
+    /** Returns the player who has a live combo on their own turn, or null. Cheap enough to run on every state check. */
+    public static Player liveComboWinner(Game game) {
+        if (decks().isEmpty() || game.getPhaseHandler() == null) return null;
+        final Player p = game.getPhaseHandler().getPlayerTurn();
+        if (p == null || p.hasLost()) return null;
+        final Deck d = deckOf(p);
+        if (d == null) return null;
+        Map<String, List<Card>> onField = new HashMap<>();
+        int lands = 0;
+        for (Card c : p.getCardsIn(ZoneType.Battlefield)) {
+            onField.computeIfAbsent(c.getName(), k -> new ArrayList<>()).add(c);
+            if (c.isLand()) lands++;
+        }
+        if (lands < 4) return null;
+        for (String k : d.key) if (!onField.containsKey(k)) return null;
+        for (Set<String> combo : d.combos) {
+            boolean ok = true;
+            for (String piece : combo) {
+                List<Card> cs = onField.get(piece);
+                if (cs == null) { ok = false; break; }
+                if (STRICT || d.noSameTurn.contains(piece)) {
+                    boolean any = false;
+                    for (Card c : cs) if (settled(c, game)) { any = true; break; }
+                    if (!any) { ok = false; break; }
+                }
+            }
+            if (ok) {
+                lastCombo = String.join(" + ", new TreeSet<>(combo));
+                return p;
+            }
+        }
+        return null;
+    }
+
+    public static String lastCombo = "";
+}
