diff --git a/forge-ai/src/main/java/forge/ai/ComboAwareAi.java b/forge-ai/src/main/java/forge/ai/ComboAwareAi.java
new file mode 100644
index 00000000..cbddc226
--- /dev/null
+++ b/forge-ai/src/main/java/forge/ai/ComboAwareAi.java
@@ -0,0 +1,124 @@
+package forge.ai;
+
+import forge.game.RefereeCombos;
+import forge.game.GameObject;
+import forge.game.card.Card;
+import forge.game.spellability.SpellAbility;
+import forge.game.card.CardCollectionView;
+import forge.game.player.Player;
+import forge.game.zone.ZoneType;
+
+import java.util.*;
+
+/**
+ * [deck-lab patch] AI helpers that use the deck's known combos (from RefereeCombos):
+ *  - tutoring: fetch the card that leaves the fewest pieces missing for any combo, given what is already
+ *    on the battlefield and in hand (the commander counts once it can be cast from the command zone);
+ *  - mulligans: a 7-card opening hand with no combo piece and no tutor is shipped back once.
+ */
+public final class ComboAwareAi {
+    private ComboAwareAi() { }
+
+    private static Set<String> have(Player ai) {
+        Set<String> s = new HashSet<>();
+        for (Card c : ai.getCardsIn(ZoneType.Battlefield)) s.add(c.getName());
+        for (Card c : ai.getCardsIn(ZoneType.Hand)) s.add(c.getName());
+        for (Card c : ai.getCardsIn(ZoneType.Command)) s.add(c.getName());
+        return s;
+    }
+
+    private static int missing(Set<String> combo, Set<String> have, String extra) {
+        int m = 0;
+        for (String p : combo) if (!have.contains(p) && !p.equals(extra)) m++;
+        return m;
+    }
+
+    /** Best tutor target among fetchList, or null if no candidate brings a combo closer. */
+    public static Card bestTutorTarget(Player ai, CardCollectionView fetchList) {
+        final RefereeCombos.Deck d = RefereeCombos.deckOf(ai);
+        if (d == null || fetchList == null || fetchList.isEmpty()) return null;
+        final Set<String> have = have(ai);
+        for (String k : d.key) if (!have.contains(k)) return null; // no commander access: fall back to defaults
+        int bestNow = Integer.MAX_VALUE;
+        for (Set<String> c : d.combos) bestNow = Math.min(bestNow, missing(c, have, null));
+        Card best = null; int bestAfter = bestNow; int bestCount = -1;
+        Map<String, Card> byName = new LinkedHashMap<>();
+        for (Card c : fetchList) if (d.pieces.contains(c.getName()) && !have.contains(c.getName())) byName.putIfAbsent(c.getName(), c);
+        for (Map.Entry<String, Card> e : byName.entrySet()) {
+            int after = Integer.MAX_VALUE, count = 0;
+            for (Set<String> c : d.combos) {
+                if (!c.contains(e.getKey())) continue;
+                int m = missing(c, have, e.getKey());
+                if (m < after) { after = m; count = 1; } else if (m == after) count++;
+            }
+            // prefer the card that gets closest to a finished combo; break ties by how many combos it advances
+            if (after < bestAfter || (after == bestAfter && best != null && count > bestCount)) {
+                best = e.getValue(); bestAfter = after; bestCount = count;
+            }
+        }
+        return best;
+    }
+
+    /** True if this opening hand has no route to the engine (no combo piece, no tutor). Only judges 7-card hands. */
+    public static boolean noEngineHand(Player ai, CardCollectionView hand) {
+        final RefereeCombos.Deck d = RefereeCombos.deckOf(ai);
+        if (d == null || hand.size() < 7) return false;
+        for (Card c : hand) {
+            if (d.pieces.contains(c.getName())) return false;
+            String t = c.getOracleText();
+            if (t != null && t.contains("Search your library for") && !t.contains("basic land") && !t.contains("land card")) return false;
+        }
+        return true;
+    }
+
+    /** Protection spells are held for when an opponent's spell or ability threatens a combo piece or key card. */
+    public static boolean holdProtection(Player ai, SpellAbility sa) {
+        final RefereeCombos.Deck d = RefereeCombos.deckOf(ai);
+        if (d == null || !d.protection.contains(sa.getHostCard().getName())) return false;
+        final forge.game.Game game = ai.getGame();
+        if (game.getStack().isEmpty()) return true;
+        final SpellAbility top = game.getStack().peekAbility();
+        if (top == null || top.getActivatingPlayer() == null || !top.getActivatingPlayer().isOpponentOf(ai)) return true;
+        if (top.usesTargeting() && top.getTargets() != null) {
+            for (Object t : top.getTargets()) {
+                if (t instanceof Card) {
+                    Card c = (Card) t;
+                    if (c.getController().equals(ai) && (d.pieces.contains(c.getName()) || d.key.contains(c.getName()))) return false;
+                }
+            }
+        }
+        for (GameObject o : ComputerUtil.predictThreatenedObjects(ai, null, true)) {
+            if (o instanceof Card) {
+                Card c = (Card) o;
+                if (c.getController().equals(ai) && (d.pieces.contains(c.getName()) || d.key.contains(c.getName()))) return false;
+            }
+        }
+        // Veil of Summer-style cards also answer counterspells: allow when an opponent's spell targets our spell
+        if (top.isSpell() && top.usesTargeting() && top.getTargets() != null) {
+            for (Object t : top.getTargets()) {
+                if (t instanceof SpellAbility && ((SpellAbility) t).getActivatingPlayer() != null && ((SpellAbility) t).getActivatingPlayer().equals(ai)) return false;
+            }
+        }
+        return true;
+    }
+
+    /**
+     * Removal priority bonus for an opponent's card: a piece of one of its controller's known combos (bigger the
+     * closer that combo is to done), or a commander. Real players know the engine card is the one to kill.
+     */
+    public static int comboThreatBonus(Card c) {
+        int bonus = c.isCommander() ? 150 : 0;
+        final RefereeCombos.Deck d = RefereeCombos.deckOf(c.getController());
+        if (d == null || !(d.pieces.contains(c.getName()) || d.key.contains(c.getName()))) return bonus;
+        if (d.key.contains(c.getName())) bonus += 200;
+        final Set<String> onField = new HashSet<>();
+        for (Card x : c.getController().getCardsIn(ZoneType.Battlefield)) onField.add(x.getName());
+        int best = Integer.MAX_VALUE;
+        for (Set<String> combo : d.combos) {
+            if (!combo.contains(c.getName())) continue;
+            best = Math.min(best, missing(combo, onField, null));
+        }
+        if (best == Integer.MAX_VALUE) return bonus + 100;
+        return bonus + (best == 0 ? 900 : best == 1 ? 500 : 250);
+    }
+}
